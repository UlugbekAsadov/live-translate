{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Translate",
  "version": "0.1.0",
  "identifier": "com.livetranslate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Meeting Translator",
        "width": 900,
        "height": 660,
        "minWidth": 760,
        "minHeight": 540
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Translator Overlay",
        "width": 720,
        "height": 190,
        "minWidth": 280,
        "minHeight": 110,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
